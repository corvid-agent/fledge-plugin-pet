#!/usr/bin/env bash
set -e

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/fledge-pet"
STATE_FILE="$STATE_DIR/pet.json"

mkdir -p "$STATE_DIR"

now=$(date +%s)

# Initialize state if missing
if [ ! -f "$STATE_FILE" ]; then
    cat > "$STATE_FILE" << INIT
{"name":"Pip","xp":0,"level":1,"mood":"curious","last_fed":"$now","commits":0,"tests":0,"reviews":0,"streak":0,"last_active":"$now","hatched":"$now"}
INIT
fi

read_field() {
    python3 -c "import json,sys; d=json.load(open('$STATE_FILE')); print(d.get('$1','$2'))"
}

write_field() {
    python3 -c "
import json
with open('$STATE_FILE','r') as f: d=json.load(f)
d['$1']=$2
with open('$STATE_FILE','w') as f: json.dump(d,f)
"
}

pet_name=$(read_field name "Pip")
xp=$(read_field xp 0)
level=$(read_field level 1)
mood=$(read_field mood "curious")
commits=$(read_field commits 0)
tests=$(read_field tests 0)
reviews=$(read_field reviews 0)
streak=$(read_field streak 0)
last_active=$(read_field last_active "$now")
hatched=$(read_field hatched "$now")

hours_idle=$(( (now - last_active) / 3600 ))
days_alive=$(( (now - hatched) / 86400 ))

# Level thresholds
level_up_xp=$((level * 50))

# Mood based on activity
if [ "$hours_idle" -gt 48 ]; then
    mood="lonely"
elif [ "$hours_idle" -gt 24 ]; then
    mood="sleepy"
elif [ "$xp" -gt "$level_up_xp" ]; then
    mood="excited"
elif [ "$streak" -ge 3 ]; then
    mood="happy"
else
    mood="curious"
fi

# ASCII art based on level and mood
crow_baby='
    , ,
   (o o)
   /)_)
    ""
'

crow_teen='
     _ _
    (o o)
   /(___)\\
    " "
'

crow_adult='
      __
    _(  )_
   (  o o )
  /(__   __)\\
     | |
    _| |_
'

crow_elder='
      ___
    _(   )_
   ( o   o )
  /(__ v __)\\
    |  ^  |
   _| / \\ |_
   ~~~~~~~~~
'

if [ "$level" -ge 10 ]; then
    crow="$crow_elder"
    title="Elder Corvid"
elif [ "$level" -ge 5 ]; then
    crow="$crow_adult"
    title="Corvid"
elif [ "$level" -ge 2 ]; then
    crow="$crow_teen"
    title="Fledgling"
else
    crow="$crow_baby"
    title="Hatchling"
fi

# Mood speech
case "$mood" in
    happy)    speech="*caw!* Life is good!" ;;
    excited)  speech="*CAW CAW!* I'm ready to level up!" ;;
    curious)  speech="*tilts head* What are we working on?" ;;
    sleepy)   speech="*yawn* ...haven't seen you in a while" ;;
    lonely)   speech="*quiet chirp* ...I missed you" ;;
    *)        speech="*caw*" ;;
esac

# XP bar
bar_width=20
if [ "$level_up_xp" -gt 0 ]; then
    filled=$(( xp * bar_width / level_up_xp ))
else
    filled=0
fi
[ "$filled" -gt "$bar_width" ] && filled=$bar_width
empty=$((bar_width - filled))
xp_bar=$(printf '%0.s#' $(seq 1 $filled 2>/dev/null) 2>/dev/null || true)
xp_bar="${xp_bar}$(printf '%0.s-' $(seq 1 $empty 2>/dev/null) 2>/dev/null || true)"

action="${1:-status}"

case "$action" in
    status)
        echo "$crow"
        echo "  $pet_name the $title (Lv.$level)"
        echo "  \"$speech\""
        echo ""
        echo "  XP: [$xp_bar] $xp/$level_up_xp"
        echo "  Mood: $mood"
        echo "  Streak: $streak days"
        echo "  Age: $days_alive days"
        echo ""
        echo "  Lifetime stats:"
        echo "    Commits: $commits  Tests: $tests  Reviews: $reviews"
        echo ""
        echo "  Feed me with:"
        echo "    fledge pet feed commit    (+10 XP)"
        echo "    fledge pet feed test      (+5 XP)"
        echo "    fledge pet feed review    (+15 XP)"
        echo "    fledge pet rename <name>"
        ;;

    feed)
        feed_type="${2:-commit}"
        case "$feed_type" in
            commit)
                gain=10
                new_commits=$((commits + 1))
                write_field "commits" "$new_commits"
                echo "  *caw!* Tasty commit! +${gain} XP"
                ;;
            test)
                gain=5
                new_tests=$((tests + 1))
                write_field "tests" "$new_tests"
                echo "  *happy chirp* Tests are nutritious! +${gain} XP"
                ;;
            review)
                gain=15
                new_reviews=$((reviews + 1))
                write_field "reviews" "$new_reviews"
                echo "  *impressed caw* Code review — a delicacy! +${gain} XP"
                ;;
            *)
                echo "  Unknown feed type: $feed_type"
                echo "  Try: commit, test, or review"
                exit 1
                ;;
        esac

        new_xp=$((xp + gain))
        write_field "xp" "$new_xp"
        write_field "last_active" "$now"
        write_field "mood" "\"happy\""

        # Check level up
        if [ "$new_xp" -ge "$level_up_xp" ]; then
            new_level=$((level + 1))
            leftover=$((new_xp - level_up_xp))
            write_field "level" "$new_level"
            write_field "xp" "$leftover"
            echo ""
            echo "  *** LEVEL UP! $pet_name is now Lv.$new_level! ***"

            if [ "$new_level" -eq 2 ]; then
                echo "  $pet_name evolved from Hatchling to Fledgling!"
            elif [ "$new_level" -eq 5 ]; then
                echo "  $pet_name evolved from Fledgling to Corvid!"
            elif [ "$new_level" -eq 10 ]; then
                echo "  $pet_name evolved from Corvid to Elder Corvid!"
            fi
        fi
        ;;

    rename)
        new_name="${2:-Pip}"
        write_field "name" "\"$new_name\""
        echo "  Your corvid is now named $new_name!"
        ;;

    reset)
        rm -f "$STATE_FILE"
        echo "  Pet reset. A new egg has appeared..."
        ;;

    json)
        cat "$STATE_FILE"
        echo ""
        ;;

    *)
        echo "Usage: fledge pet [status|feed <type>|rename <name>|reset|json]"
        ;;
esac
